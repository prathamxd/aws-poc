# Copy to .env for LOCAL development only. .env is git-ignored - never commit it.
# On AWS none of these are used for secrets: the app reads Secrets Manager instead.

APP_ENV=local

# Session signing key (any long random string for local use)
SECRET_KEY=change-me-to-a-long-random-string

# First admin account, created on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Option A (simplest): SQLite file, no database server needed
DATABASE_URL=sqlite:///./ticketdesk.db

# Option B: docker compose starts PostgreSQL and overrides DATABASE_URL itself.
# Letters and numbers only for this password.
POSTGRES_PASSWORD=changeme123local

# Attachments: leave S3_BUCKET empty to store files in ./uploads
UPLOAD_DIR=./uploads
S3_BUCKET=
MAX_UPLOAD_MB=5
