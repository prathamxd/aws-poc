# Shared remote state in S3 for the team (Pratham creates the bucket once).
# 1. Create a bucket once (not managed by this stack), e.g.:
#      aws s3api create-bucket --bucket aws-poc-tfstate-<ACCOUNT_ID> --region ap-south-1 \
#        --create-bucket-configuration LocationConstraint=ap-south-1
#      aws s3api put-bucket-versioning --bucket aws-poc-tfstate-<ACCOUNT_ID> --versioning-configuration Status=Enabled
#      aws s3api put-public-access-block --bucket aws-poc-tfstate-<ACCOUNT_ID> \
#        --public-access-block-configuration BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
# 2. Rename this file to backend.tf, fill in the bucket, then run: terraform init -migrate-state
# use_lockfile needs Terraform >= 1.10 (S3-native state locking, no DynamoDB table needed).

terraform {
  backend "s3" {
    bucket       = "aws-poc-tfstate-<ACCOUNT_ID>"
    key          = "ticketdesk/poc/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
