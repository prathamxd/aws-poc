# Random values generated by Terraform and stored ONLY in Secrets Manager
# (and in the local, git-ignored terraform.tfstate). The app reads them at runtime.

resource "random_password" "admin" {
  length  = 20
  special = false
}

resource "random_password" "session_key" {
  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "app" {
  name_prefix = "${var.name_prefix}/app-"
  description = "TicketDesk application secrets: session signing key and initial admin login"

  # POC: delete immediately on destroy so the stack can be re-created right away
  recovery_window_in_days = 0

  tags = {
    Name = "${var.name_prefix}-app-secret"
  }
}

resource "aws_secretsmanager_secret_version" "app" {
  secret_id = aws_secretsmanager_secret.app.id
  secret_string = jsonencode({
    admin_username = var.admin_username
    admin_password = random_password.admin.result
    secret_key     = random_password.session_key.result
  })
}
